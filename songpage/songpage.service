[Unit]
Description=songpage progressive music player
After=network-online.target
Wants=network-online.target

[Service]
User=soumil
Group=soumil
WorkingDirectory=/home/soumil/musicapp
Environment=TRACK_FILE=/home/soumil/music/aria-math.mp3
Environment=PLAYER_PORT=8080
ExecStart=/usr/bin/python3 /home/soumil/musicapp/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
