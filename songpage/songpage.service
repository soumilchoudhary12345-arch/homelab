[Unit]
Description=Musik music library streamer
After=network-online.target
Wants=network-online.target

[Service]
User=soumil
Group=soumil
WorkingDirectory=/home/soumil/musicapp
Environment=MUSIC_ROOT=/srv/nas/music
Environment=MUSIK_DB=/home/soumil/.local/state/musik/library.db
Environment=PLAYER_PORT=8080
ExecStart=/usr/bin/python3 /home/soumil/musicapp/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
